<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac mini, ~/Library/LaunchAgents. Weekly reviews for chifstays.com: reviews-weekly.sh -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.chifstays.reviews</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/code</string>
		<key>PATH</key>
		<string>/Users/code/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/code/.local/bin/quit-after</string>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/bash</string>
		<string>/Users/code/repos/chifstays-reviews.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>40</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/code/repos/chifstays-reviews.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/code/repos/chifstays-reviews.launchd.log</string>
</dict>
</plist>
